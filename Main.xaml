<Grid xmlns='http://schemas.microsoft.com/winfx/2006/xaml/presentation'
      xmlns:x='http://schemas.microsoft.com/winfx/2006/xaml'
      Background='{StaticResource Bg}' AllowDrop='True'>

  <!-- Home screen -->
  <ScrollViewer x:Name='HomeView' VerticalScrollBarVisibility='Auto' Focusable='False'>
    <StackPanel HorizontalAlignment='Center' Width='760' Margin='24,0,24,40'>
      <TextBlock Text='Read in peace.' FontSize='40' FontWeight='SemiBold' HorizontalAlignment='Center' Margin='0,96,0,8'
                 Foreground='{StaticResource TextMain}' FontFamily='Segoe UI Variable Display, Segoe UI'/>
      <TextBlock Text='A calm, fast PDF reader. Files stay on this PC unless you ask AI about them.' FontSize='14'
                 HorizontalAlignment='Center' Foreground='{StaticResource Muted}' Margin='0,0,0,34'/>

      <Button x:Name='OpenCardButton' Style='{StaticResource OpenCard}' Width='540' HorizontalAlignment='Center'>
        <DockPanel LastChildFill='True'>
          <Border DockPanel.Dock='Left' Width='50' Height='50' CornerRadius='10' Background='{StaticResource AccentSoft}' Margin='0,0,18,0'>
            <TextBlock Text='&#xE898;' FontFamily='{StaticResource Icons}' FontSize='21' Foreground='{StaticResource Accent}'
                       HorizontalAlignment='Center' VerticalAlignment='Center'/>
          </Border>
          <Border DockPanel.Dock='Right' VerticalAlignment='Center' BorderBrush='{StaticResource LineStrong}' BorderThickness='1' CornerRadius='5' Padding='7,3' Margin='18,0,0,0'>
            <TextBlock Text='Ctrl O' FontSize='11' Foreground='{StaticResource Muted}'/>
          </Border>
          <StackPanel VerticalAlignment='Center'>
            <TextBlock Text='Open a PDF' FontSize='16' FontWeight='SemiBold' Foreground='{StaticResource TextMain}' Margin='0,0,0,3'/>
            <TextBlock Text='Drop a PDF anywhere, or click to browse' FontSize='13' Foreground='{StaticResource Muted}'/>
          </StackPanel>
        </DockPanel>
      </Button>

      <DockPanel x:Name='RecentHeader' Margin='6,64,6,12'>
        <Button x:Name='ClearRecentButton' DockPanel.Dock='Right' Style='{StaticResource Flat}' Padding='8,4'>
          <TextBlock Text='Clear all' FontSize='12.5'/>
        </Button>
        <TextBlock Text='RECENT' FontSize='12' Foreground='{StaticResource Muted}' VerticalAlignment='Center'/>
      </DockPanel>
      <WrapPanel x:Name='RecentPanel'/>
    </StackPanel>
  </ScrollViewer>

  <!-- Reader -->
  <Grid x:Name='ReaderView' Visibility='Collapsed'>
    <Grid.RowDefinitions>
      <RowDefinition Height='52'/>
      <RowDefinition Height='*'/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width='*'/>
      <ColumnDefinition Width='Auto'/>
    </Grid.ColumnDefinitions>

    <Border Grid.ColumnSpan='2' BorderBrush='{StaticResource Line}' BorderThickness='0,0,0,1'>
      <Grid Margin='10,0'>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width='*'/>
          <ColumnDefinition Width='Auto'/>
          <ColumnDefinition Width='*'/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation='Horizontal' VerticalAlignment='Center'>
          <Button x:Name='HomeButton' Style='{StaticResource Flat}' ToolTip='Back to home' Padding='9,8'>
            <TextBlock Text='&#xE72B;' FontFamily='{StaticResource Icons}' FontSize='14'/>
          </Button>
          <TextBlock x:Name='FileNameText' FontSize='13.5' FontWeight='SemiBold' Foreground='{StaticResource TextMain}' VerticalAlignment='Center' Margin='8,0,0,0' MaxWidth='300' TextTrimming='CharacterEllipsis'/>
        </StackPanel>

        <StackPanel Grid.Column='1' Orientation='Horizontal' VerticalAlignment='Center'>
          <Button x:Name='PrevButton' Style='{StaticResource Flat}' ToolTip='Previous page (Left arrow)' Padding='9,8'>
            <TextBlock Text='&#xE76B;' FontFamily='{StaticResource Icons}' FontSize='12'/>
          </Button>
          <TextBlock x:Name='PageText' FontSize='13' Foreground='{StaticResource Muted}' VerticalAlignment='Center' MinWidth='82' TextAlignment='Center'/>
          <Button x:Name='NextButton' Style='{StaticResource Flat}' ToolTip='Next page (Right arrow)' Padding='9,8'>
            <TextBlock Text='&#xE76C;' FontFamily='{StaticResource Icons}' FontSize='12'/>
          </Button>
          <Rectangle Width='1' Height='20' Fill='{StaticResource Line}' Margin='12,0'/>
          <Button x:Name='ZoomOutButton' Style='{StaticResource Flat}' ToolTip='Zoom out (Ctrl+Minus)' Padding='9,8'>
            <TextBlock Text='&#xE71F;' FontFamily='{StaticResource Icons}' FontSize='14'/>
          </Button>
          <TextBlock x:Name='ZoomText' FontSize='13' Foreground='{StaticResource Muted}' VerticalAlignment='Center' MinWidth='46' TextAlignment='Center'/>
          <Button x:Name='ZoomInButton' Style='{StaticResource Flat}' ToolTip='Zoom in (Ctrl+Plus)' Padding='9,8'>
            <TextBlock Text='&#xE8A3;' FontFamily='{StaticResource Icons}' FontSize='14'/>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column='2' Orientation='Horizontal' HorizontalAlignment='Right' VerticalAlignment='Center'>
          <Button x:Name='PrintButton' Style='{StaticResource Flat}' ToolTip='Print (Ctrl+P)'>
            <StackPanel Orientation='Horizontal'>
              <TextBlock Text='&#xE749;' FontFamily='{StaticResource Icons}' FontSize='14' VerticalAlignment='Center' Margin='0,0,7,0'/>
              <TextBlock x:Name='PrintText' Text='Print' FontSize='13'/>
            </StackPanel>
          </Button>
          <Button x:Name='AiButton' Style='{StaticResource AccentBtn}' ToolTip='Summarize or ask questions' Margin='6,0,0,0'>
            <StackPanel Orientation='Horizontal'>
              <TextBlock Text='&#xE945;' FontFamily='{StaticResource Icons}' FontSize='14' VerticalAlignment='Center' Margin='0,0,7,0'/>
              <TextBlock Text='Ask AI' FontSize='13' FontWeight='SemiBold'/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer x:Name='PageScroller' Grid.Row='1' HorizontalScrollBarVisibility='Auto' VerticalScrollBarVisibility='Auto'
                  Background='{StaticResource PageBg}' Focusable='False'>
      <Border HorizontalAlignment='Center' VerticalAlignment='Center' Margin='14'>
        <Border.Effect>
          <DropShadowEffect BlurRadius='24' ShadowDepth='3' Opacity='0.55' Color='Black'/>
        </Border.Effect>
        <Image x:Name='PageImage' RenderOptions.BitmapScalingMode='NearestNeighbor' SnapsToDevicePixels='True'/>
      </Border>
    </ScrollViewer>

    <!-- AI panel -->
    <Border x:Name='AiPanel' Grid.Row='1' Grid.Column='1' Width='390' Background='{StaticResource PanelBg}'
            BorderBrush='{StaticResource Line}' BorderThickness='1,0,0,0' Visibility='Collapsed'>
      <DockPanel>
        <DockPanel DockPanel.Dock='Top' Margin='14,12,8,8'>
          <Button x:Name='AiCloseButton' DockPanel.Dock='Right' Style='{StaticResource Flat}' ToolTip='Close' Padding='8,7'>
            <TextBlock Text='&#xE711;' FontFamily='{StaticResource Icons}' FontSize='11'/>
          </Button>
          <Button x:Name='NewChatButton' DockPanel.Dock='Right' Style='{StaticResource Flat}' ToolTip='New chat' Padding='8,7'>
            <TextBlock Text='&#xE710;' FontFamily='{StaticResource Icons}' FontSize='12'/>
          </Button>
          <StackPanel Orientation='Horizontal'>
            <TextBlock Text='&#xE945;' FontFamily='{StaticResource Icons}' FontSize='14' VerticalAlignment='Center' Foreground='{StaticResource TextMain}' Margin='0,0,7,0'/>
            <TextBlock Text='Ask AI' FontSize='14' FontWeight='SemiBold' VerticalAlignment='Center' Foreground='{StaticResource TextMain}' Margin='0,0,12,0'/>
            <Border Background='{StaticResource Card}' CornerRadius='8' Padding='3'>
              <StackPanel Orientation='Horizontal'>
                <RadioButton x:Name='OpenAiChoice' Style='{StaticResource Segment}' GroupName='Provider' Content='ChatGPT'/>
                <RadioButton x:Name='ClaudeChoice' Style='{StaticResource Segment}' GroupName='Provider' Content='Claude'/>
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>

        <StackPanel x:Name='Composer' DockPanel.Dock='Bottom' Margin='14,8,14,14' Visibility='Collapsed'>
          <Grid>
            <TextBox x:Name='AskBox' AcceptsReturn='True' TextWrapping='Wrap' MaxHeight='120' MinHeight='40' Padding='10,9,44,9'
                     VerticalScrollBarVisibility='Auto' FontSize='13.5'/>
            <TextBlock x:Name='AskHint' Text='Ask about this PDF' IsHitTestVisible='False' Foreground='{StaticResource Dim}' FontSize='13.5' Margin='13,10,0,0'/>
            <Button x:Name='SendButton' Style='{StaticResource AccentBtn}' HorizontalAlignment='Right' VerticalAlignment='Bottom' Margin='0,0,5,5' Padding='8,6' ToolTip='Send (Enter)'>
              <TextBlock x:Name='SendIcon' Text='&#xE724;' FontFamily='{StaticResource Icons}' FontSize='13'/>
            </Button>
          </Grid>
          <DockPanel Margin='2,8,0,0'>
            <Button x:Name='SignOutButton' DockPanel.Dock='Right' Style='{StaticResource Flat}' Padding='6,2'><TextBlock Text='Sign out' FontSize='11.5' Foreground='{StaticResource Muted}'/></Button>
            <Button x:Name='ManageButton' DockPanel.Dock='Right' Style='{StaticResource Flat}' Padding='6,2'><TextBlock Text='Manage usage' FontSize='11.5' Foreground='{StaticResource Muted}'/></Button>
            <TextBlock x:Name='StatusText' FontSize='11.5' Foreground='{StaticResource Muted}' VerticalAlignment='Center' TextTrimming='CharacterEllipsis'/>
          </DockPanel>
          <TextBlock x:Name='PrivacyNote' FontSize='11.5' Foreground='{StaticResource Dim}' TextWrapping='Wrap' Margin='2,4,0,0'/>
        </StackPanel>

        <Grid>
          <Border x:Name='SignInCard' VerticalAlignment='Top' Margin='14,8,14,14' Padding='18' CornerRadius='12' Background='{StaticResource Card}'
                  BorderBrush='{StaticResource Line}' BorderThickness='1' Visibility='Collapsed'>
            <StackPanel>
              <TextBlock x:Name='CardTitle' FontSize='15.5' FontWeight='SemiBold' Foreground='{StaticResource TextMain}' Margin='0,0,0,8'/>
              <TextBlock x:Name='CardBody' FontSize='13.5' LineHeight='20' Foreground='{StaticResource Muted}' TextWrapping='Wrap' Margin='0,0,0,14'/>
              <Button x:Name='CardPrimary' Style='{StaticResource WhiteBtn}' Padding='12,10'>
                <TextBlock x:Name='CardPrimaryText' FontSize='13.5' FontWeight='SemiBold'/>
              </Button>
              <StackPanel Orientation='Horizontal' HorizontalAlignment='Right'>
                <Button x:Name='CardSecondary' Style='{StaticResource Flat}' Padding='12,9' Margin='0,0,8,0'>
                  <TextBlock x:Name='CardSecondaryText' FontSize='13.5' FontWeight='SemiBold'/>
                </Button>
                <Button x:Name='CardCoral' Style='{StaticResource CoralBtn}' Padding='16,9'>
                  <TextBlock Text='Check again' FontSize='13.5' FontWeight='SemiBold'/>
                </Button>
              </StackPanel>
              <TextBlock x:Name='CardNote' FontSize='11.5' LineHeight='17' Foreground='{StaticResource Dim}' TextWrapping='Wrap' Margin='0,14,0,0'/>
            </StackPanel>
          </Border>
          <ScrollViewer x:Name='ChatScroller' VerticalScrollBarVisibility='Auto' Focusable='False'>
            <StackPanel x:Name='ChatPanel' Margin='14,4,14,8'>
              <StackPanel x:Name='AiEmpty' Margin='0,26,0,0'>
                <TextBlock Text='Understand this PDF' FontSize='18' FontWeight='SemiBold' Foreground='{StaticResource TextMain}' Margin='0,0,0,6'/>
                <TextBlock Text='Get a summary, or ask anything about what it says. Answers cite page numbers so you can check them.' FontSize='13' Foreground='{StaticResource Muted}' TextWrapping='Wrap' Margin='0,0,0,16'/>
                <Button x:Name='SummarizeButton' Style='{StaticResource AccentBtn}' HorizontalAlignment='Left' Padding='14,9'>
                  <TextBlock Text='Summarize this PDF' FontSize='13' FontWeight='SemiBold'/>
                </Button>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</Grid>
